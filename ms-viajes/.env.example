# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto donde escucha este microservicio.
# ms-viajes usa el 3011; los microservicios de los estudiantes, del 3002 en adelante.

PORT=3011
DB_HOST=localhost
DB_PORT=3306
DB_NAME=viajes_db
DB_USER=viajes_user
DB_PASSWORD=ConsultaConElEquipo
JWT_SECRET=cambie-esta-frase-por-una-larga-y-secreta
JWT_EXPIRA=30d